{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run benchmark (small universe)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_benchmark.py",
      "args": ["config.small.yaml"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Debug current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python"
    }
  ]
}
